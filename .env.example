# Lemonade Control Center — Configuration

# Lemonade Server
LEMONADE_URL=http://localhost:13305
LEMONADE_ADMIN_API_KEY=

# Safety flags (disabled by default)
ENABLE_DELETE=false
ENABLE_RESTART=false
ENABLE_BENCH_LAB=false
TELEMETRY_SCOPE=host
CAPABILITIES_MODE=file

# LCC access control
# Localhost is trusted by default. LAN/remote API access requires LCC_API_KEY.
LCC_API_KEY=
REQUIRE_AUTH=false
# Extra browser origins allowed to open LCC WebSockets and send state-changing requests,
# comma-separated. Only needed behind a reverse proxy that does not forward the original
# Host header.
ALLOWED_ORIGINS=
# Names besides localhost and IP addresses under which LCC can be opened from its own host
# without a key, comma-separated. List only names you control.
ALLOWED_HOSTS=
# Addresses of reverse proxies that set X-Forwarded-For, comma-separated, for example
# 127.0.0.1. LCC then records the real client address. The proxy must overwrite the header.
# Clients that come through a proxy need LCC_API_KEY whether or not this is set.
TRUSTED_PROXY_IPS=

# Unified runtime
# Development can still run FastAPI on 8000 and Vite on 5173.
# The single-process runtime uses APP_HOST/APP_PORT with `python -m app.run`.
APP_HOST=127.0.0.1
APP_PORT=17600
SERVE_FRONTEND=true
FRONTEND_BUILD_DIR=../frontend/build
LAN_MODE=false

# Long-run metrics history (SQLite, backend/app/data/lcc_metrics.db)
# Retention in days, applied on startup and hourly; 0 means no limit.
# Task records are kept indefinitely by default.
TASK_RETENTION_DAYS=0
HARDWARE_RETENTION_DAYS=30
TASK_SAMPLER_INTERVAL_SECONDS=15
METRICS_PRUNE_INTERVAL_SECONDS=3600

# Container examples override APP_HOST/LAN_MODE/REQUIRE_AUTH and require LCC_API_KEY.
# LCC_PORT controls only the host-side Compose port mapping.
LCC_PORT=17600
